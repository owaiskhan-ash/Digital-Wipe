# Untrace environment variables

# Grounded Google Search through Gemini. Required for the AI search.
# Google AI Studio keys start with AIza. Keys issued in the new AQ. format are
# retried against Vertex automatically, so either works.
GEMINI_API_KEY=""

# Optional search provider, used when the grounded search returns nothing.
# Configure one. DuckDuckGo is the built-in last resort, but it blocks requests
# from datacenter IPs, so a keyed provider is what keeps the fallback alive.
BRAVE_SEARCH_API_KEY=""
SERPER_API_KEY=""
TAVILY_API_KEY=""

# Google Programmable Search needs both values.
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_CX=""
